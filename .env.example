# Скопируйте в .env и заполните для продакшена. Все переменные необязательны —
# без них приложение работает с безопасными значениями по умолчанию.

# Порт HTTP-сервера (по умолчанию 3000)
PORT=3000

# Секрет для подписи JWT. Если не задан — генерируется автоматически и сохраняется
# в data/.jwtsecret. На проде задайте свой длинный случайный секрет, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Путь к файлу базы SQLite (по умолчанию data/nochotel.db)
NOCHOTEL_DB=
