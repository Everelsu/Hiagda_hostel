# Docker: достаточно одной строки PGPASSWORD=… (подключение к базе compose задаёт сам).
#
# Скопируйте в .env и заполните. Файл читается при запуске сервера, сида и скриптов
# резервного копирования. Переменные, уже заданные в окружении (systemd, docker),
# имеют приоритет над этим файлом.

# ── Сервер ────────────────────────────────────────────────────────────────────
# Порт HTTP-сервера (по умолчанию 3000)
PORT=3000

# Секрет для подписи JWT. Если не задан — генерируется автоматически и сохраняется
# в data/.jwtsecret. На проде задайте свой длинный случайный секрет:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── База данных PostgreSQL ────────────────────────────────────────────────────
# Вариант 1 — одной строкой (удобно для systemd и docker):
# DATABASE_URL=postgresql://nochotel:пароль@127.0.0.1:5432/nochotel

# Вариант 2 — по частям. Используется, если DATABASE_URL не задан.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nochotel
PGUSER=nochotel
PGPASSWORD=

# Размер пула соединений (по умолчанию 10). Больше числа одновременно работающих
# сотрудников не нужно: лишние соединения только занимают память на сервере СУБД.
# PGPOOL_MAX=10

# ── Тесты ─────────────────────────────────────────────────────────────────────
# Отдельная база: перед каждым прогоном её схема удаляется целиком.
# Рабочую базу указывать нельзя.
# TEST_DATABASE_URL=postgresql://nochotel:пароль@127.0.0.1:5432/nochotel_test

# ── Карты ─────────────────────────────────────────────────────────────────────
# Ключ «JavaScript API и HTTP Геокодер» из developer.tech.yandex.ru. С ним основная карта —
# Яндекс (точнее по России) и поиск адреса через геокодер Яндекса. Без ключа — OpenStreetMap.
# YANDEX_MAPS_KEY=

# ── Резервное копирование ─────────────────────────────────────────────────────
# Сервер сам снимает копию раз в сутки в это время (ЧЧ:ММ по часам сервера).
# off — выключить, если копии снимает внешний cron/systemd-таймер.
# BACKUP_AT=03:00
# Часовой пояс сервера (в Docker по умолчанию UTC) — от него зависит время копии.
# TZ=Asia/Irkutsk
# Куда складывать копии (по умолчанию ./backups)
# BACKUP_DIR=/var/backups/nochotel
# Сколько последних копий хранить (по умолчанию 14)
# BACKUP_KEEP=14
# Каталог с pg_dump/pg_restore, если их нет в PATH
# PG_BIN=/usr/lib/postgresql/16/bin

# Пуш-уведомления вахтовикам (объявления, ответы по заявкам). Ключи создаются сами и хранятся
# в базе. Работают только по HTTPS (или на localhost). Контакт владельца — требование Apple/Mozilla:
# VAPID_SUBJECT=mailto:it@your-company.ru

# Уборка места (каждую ночь): файлы, на которые ничто не ссылается; фото заявок, починенных
# больше PHOTO_KEEP_DAYS дней назад (0 — хранить вечно); старые снимки перед восстановлением.
# PHOTO_KEEP_DAYS=365
# CLEANUP_AT=02:30

# Автообновление из git (sudo bash scripts/update.sh --install): какую ветку ставить и как часто проверять.
# UPDATE_BRANCH=main
# UPDATE_EVERY=15min
