# Скопируйте в .env и заполните. Файл читается при запуске сервера, сида и скриптов
# резервного копирования. Переменные, уже заданные в окружении (systemd, docker),
# имеют приоритет над этим файлом.

# ── Сервер ────────────────────────────────────────────────────────────────────
# Порт HTTP-сервера (по умолчанию 3000)
PORT=3000

# Секрет для подписи JWT. Если не задан — генерируется автоматически и сохраняется
# в data/.jwtsecret. На проде задайте свой длинный случайный секрет:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── База данных PostgreSQL ────────────────────────────────────────────────────
# Вариант 1 — одной строкой (удобно для systemd и docker):
# DATABASE_URL=postgresql://nochotel:пароль@127.0.0.1:5432/nochotel

# Вариант 2 — по частям. Используется, если DATABASE_URL не задан.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nochotel
PGUSER=nochotel
PGPASSWORD=

# Размер пула соединений (по умолчанию 10). Больше числа одновременно работающих
# сотрудников не нужно: лишние соединения только занимают память на сервере СУБД.
# PGPOOL_MAX=10

# ── Тесты ─────────────────────────────────────────────────────────────────────
# Отдельная база: перед каждым прогоном её схема удаляется целиком.
# Рабочую базу указывать нельзя.
# TEST_DATABASE_URL=postgresql://nochotel:пароль@127.0.0.1:5432/nochotel_test

# ── Резервное копирование ─────────────────────────────────────────────────────
# Куда складывать копии (по умолчанию ./backups)
# BACKUP_DIR=/var/backups/nochotel
# Сколько последних копий хранить (по умолчанию 14)
# BACKUP_KEEP=14
# Каталог с pg_dump/pg_restore, если их нет в PATH
# PG_BIN=/usr/lib/postgresql/16/bin
