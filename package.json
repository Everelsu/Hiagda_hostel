{
	"name": "nochotel",
	"version": "0.2.0",
	"private": true,
	"description": "Учёт номерного фонда вахтовых гостиниц (АО Хиагда). Vue 3 + Express + SQLite.",
	"type": "commonjs",
	"scripts": {
		"start": "node server/index.js",
		"server": "node --watch server/index.js",
		"vite": "vite",
		"dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
		"build": "vite build",
		"seed": "node server/seed.js"
	},
	"dependencies": {
		"bcryptjs": "^2.4.3",
		"better-sqlite3": "^11.3.0",
		"cors": "^2.8.5",
		"exceljs": "^4.4.0",
		"express": "^4.21.0",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.0.0",
		"pinia": "^2.2.6",
		"vue": "^3.5.13",
		"vue-router": "^4.4.5"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^6.0.7",
		"concurrently": "^9.1.0",
		"vite": "^8.1.0"
	},
	"overrides": {
		"exceljs": {
			"uuid": "^11.1.1"
		},
		"esbuild": "^0.25.0"
	}
}
